# Copy this file to `.env` for local development, then fill in the values.
# Find these in the Supabase dashboard: Project Settings -> API.
#
# NOTE: Only the publishable / anon key belongs here. It is designed to be
# public (safe to ship in a browser bundle) because Row Level Security (RLS)
# enforces what each user can access. NEVER put the `service_role` key in a
# VITE_ variable — Vite inlines VITE_* values into the client bundle, which
# would expose full database access to anyone.

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
